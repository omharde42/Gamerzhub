model VideoClip {
  id              String     @id @default(uuid())
  title           String
  sourceUrl       String
  sourcePublicId  String?
  trimmedUrl      String?
  trimmedPublicId String?
  thumbnailUrl    String?
  durationSec     Float?
  trimStartSec    Float?
  trimEndSec      Float?
  status          ClipStatus @default(UPLOADED)
  sizeBytes       Int?
  mimeType        String?
  error           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ─── Video Editing (Tier 2: montage projects, EDL-driven) ───────────────────

model MontageProject {
  id           String        @id @default(uuid())
  title        String
  edl          Json          // Edit Decision List: { segments: [{clipId, sourceUrl, start, end, transition}], music: {url, publicId, volume, trimStart}, overlays: [{text, x, y, fontSize, color, start, end}], resolution, fps }
  status       MontageStatus @default(DRAFT)
  previewUrl   String?
  renderUrl    String?
  thumbnailUrl String?
  renderError  String?
  isAiGenerated Boolean      @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─── Free Fire MVP: Teammate Discovery & Trust ──────────────────────────────

enum FreeFireTeammateRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

model FreeFireProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  freeFireUid         String?  // Self-reported UID
  freeFireUsername    String?  // Self-reported IGN
  preferredMode       String   @default("BR_SQUAD") // BR_SQUAD, CS_SQUAD, LONE_WOLF, DUO
  rank                String   @default("HEROIC") // BRONZE, SILVER, GOLD, PLATINUM, DIAMOND, HEROIC, GRANDMASTER
  playstyle           String   @default("BALANCED") // AGGRESSIVE, BALANCED, DEFENSIVE, SUPPORT, STRATEGIC
  language            String   @default("ENGLISH")
  micPreference       Boolean  @default(true)
  availability        String   @default("EVENING") // NOW, TODAY, EVENING, WEEKENDS
  teammatePreference  String?  // Description of desired partner
  isVerified          Boolean  @default(false) // Always false for self-reported Free Fire stats per policy
  reputationScore     Float    @default(5.0)
  completedSessions   Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@index([rank])
  @@index([playstyle])
  @@index([availability])
  @@index([reputationScore])
}

model FreeFireTeammateRequest {
  id         String                        @id @default(uuid())
  senderId   String
  sender     User                          @relation("FreeFireRequestsSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User                          @relation("FreeFireRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  status     FreeFireTeammateRequestStatus @default(PENDING)
  message    String?
  createdAt  DateTime                      @default(now())
  updatedAt  DateTime                      @updatedAt

  @@unique([senderId, receiverId, status])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model FreeFireSessionRating {
  id           String   @id @default(uuid())
  raterId      String
  rater        User     @relation("FreeFireRatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  ratedUserId  String
  ratedUser    User     @relation("FreeFireRatingsReceived", fields: [ratedUserId], references: [id], onDelete: Cascade)
  rating       Int      // 1 to 5 stars
  feedback     String?
  communicationRating Int? // 1 to 5 stars
  reliabilityRating   Int? // 1 to 5 stars
  createdAt    DateTime @default(now())

  @@unique([raterId, ratedUserId])
  @@index([raterId])
  @@index([ratedUserId])
}
