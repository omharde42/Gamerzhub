generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  emailVerified   DateTime?
  password        String?
  role            UserRole @default(USER)
  isTwoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  banned          Boolean  @default(false)
  banReason       String?
  discordId           String?   @unique
  discordUsername     String?
  discordDisplayName  String?
  discordAvatar       String?
  discordEmail        String?
  discordAccessToken  String?
  discordRefreshToken String?
  discordConnectedAt  DateTime?
  steamId             String?   @unique
  steamUsername       String?
  steamAvatar         String?
  steamProfileUrl     String?
  steamLevel          Int?
  steamConnectedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profile         Profile?
  accounts        Account[]
  sessions        Session[]
  devices         Device[]
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  followers       Follow[]  @relation("Following")
  following       Follow[]  @relation("Follower")
  notifications   Notification[]
  notificationSettings NotificationSettings?
  messages        Message[]
  chatParticipants ChatParticipant[]
  typingIndicators TypingIndicator[]
  teamMembers     TeamMember[]
  teamInvites     TeamInvite[]
  teamApplications TeamApplication[]
  tournamentParticipants TournamentParticipant[]
  tournamentTeamMembers   TournamentTeamMember[]
  jobApplications JobApplication[]
  reports         Report[]  @relation("ReportedUser")
  reportsMade     Report[]  @relation("Reporter")
  matchHistory    MatchHistory[]
  subscription    Subscription?
  auditLogs       AuditLog[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  pollVotes       PollVoter[]
  messageReads    MessageRead[]
  ownedOrganizations Organization[]
  organizationMemberships OrganizationMember[]
  savedJobs       SavedJob[]
  givenEndorsements Endorsement[]
  presence            UserPresence @default(OFFLINE)
  servers             ServerMember[]
  ownedServers        Server[]     @relation("ServerOwner")
  friendRequestsSent  FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived FriendRequest[] @relation("FriendRequestsReceived")
  serverMessages      ServerMessage[]
  messageReactions    MessageReaction[]
  createdEvents       ServerEvent[]
  gameRequests        GameRequest[]
  gameAccounts        GameAccount[]
  clashTagChangeCount Int        @default(0)
  clashTagHistory     Json?
  partnershipApplications PartnershipApplication[]
  challengesSent      Challenge[] @relation("ChallengesSent")
  challengesReceived  Challenge[] @relation("ChallengesReceived")
  challengeTeams      ChallengeTeam[]
  challengeParticipants ChallengeParticipant[]
  challengeNotifications ChallengeNotification[]
  userBlocks          UserBlock[]  @relation("UserBlocks")
  blockedBy           UserBlock[]  @relation("BlockedBy")
  videoClips          VideoClip[]
  montageProjects     MontageProject[]
  freeFireProfile     FreeFireProfile?
  freeFireRequestsSent FreeFireTeammateRequest[] @relation("FreeFireRequestsSent")
  freeFireRequestsReceived FreeFireTeammateRequest[] @relation("FreeFireRequestsReceived")
  freeFireRatingsGiven FreeFireSessionRating[] @relation("FreeFireRatingsGiven")
  freeFireRatingsReceived FreeFireSessionRating[] @relation("FreeFireRatingsReceived")
  profileViews        ProfileView[]
  postViews           PostView[]
  chatMessageReactions ChatMessageReaction[]
  matchDisputes       MatchDispute[]
  ticketMessages      TicketMessage[]
  tournamentSupportTickets TournamentSupportTicket[]
  tournamentActivities TournamentActivityFeed[]
  tournamentInvitationsSent TournamentInvitation[] @relation("InvitationsSent")
  tournamentInvitationsReceived TournamentInvitation[] @relation("InvitationsReceived")
  organizerRatings    TournamentOrganizerRating[]
  enteredResults      TournamentResult[] @relation("EnteredResults")
  finalizedResults    TournamentResult[] @relation("FinalizedResults")
  @@index([email])
  @@index([role])
}

model GameAccount {
  id             String    @id @default(uuid())
  userId         String
  game           String
  inGameUid      String
  inGameName     String
  changeCount    Int       @default(0)
  region         String?
  rank           String?
  level          Int?
  kdRatio        Float?
  winRate        Float?
  totalMatches   Int?
  rankRating     Int?
  headshotPct    Float?
  elo            Int?
  steamLevel     Int?
  hoursPlayed    Float?
  recentMatches  Json?
  achievements   Json?
  avatarUrl      String?
  verified       Boolean   @default(false)
  syncStatus     String?   @default("IDLE")
  lastSyncedAt   DateTime? @default(now())
  verifiedAt     DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, game])
  @@index([userId])
  @@index([game, inGameUid])
}

model Account {
  id                String          @id @default(uuid())
  provider          AccountProvider
  providerId        String
  providerUsername  String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([refreshToken])
}

model Device {
  id         String   @id @default(uuid())
  fcmToken   String
  deviceType String?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([fcmToken])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([token])
  @@index([userId])
}

model Profile {
  id                String   @id @default(uuid())
  username          String   @unique
  displayName       String?
  avatar            String?
  banner            String?
  bio               String?
  country           String?
  city              String?
  languages         String[]
  experienceLevel   String?
  playStyle         String?
  communicationStyle String?
  activeTime        String?
  age               Int?
  timezone          String?
  availability      String?
  preferredGamingTime String?
  toxicityScore     Float    @default(0)
  winRate           Float    @default(0)
  kd                Float    @default(0)
  accuracy          Float    @default(0)
  totalMatches      Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  rank              String?
  rankScore         Int      @default(0)
  role              String?
  mainGames         String[]
  gamerScore        Int      @default(0)
  skillScore        Int      @default(0)
  competitiveScore  Int      @default(0)
  communicationScore Int     @default(0)
  leadershipScore   Int      @default(0)
  teamworkScore     Int      @default(0)
  improvementRate   Float    @default(0)
  aiSummary         String?
  verified          Boolean  @default(false)
  allowComparison   Boolean  @default(true)
  twitch            String?
  youtube           String?
  discord           String?
  steam             String?
  twitter           String?
  instagram         String?
  kick              String?
  facebookGaming    String?
  website           String?
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  achievements      Achievement[]
  certifications   Certification[]
  tournamentHistory TournamentHistory[]
  connectedGames    ConnectedGame[]
  skills            GamerSkill[]
  endorsements      Endorsement[]
  views             ProfileView[]
  @@index([username])
  @@index([rank])
  @@index([country])
  @@index([winRate])
  @@index([gamerScore])
}

model ConnectedGame {
  id                String   @id @default(uuid())
  gameName          String
  publisher         String?
  playerId          String?
  uid               String?
  server            String?
  region            String?
  level             String?
  rank              String?
  highestRank       String?
  currentRank       String?
  kdRatio           Float?
  winRate           Float?
  accuracy          Float?
  headshotPct       Float?
  matchesPlayed     Int      @default(0)
  wins              Int      @default(0)
  losses            Int      @default(0)
  mvpCount          Int      @default(0)
  favoriteWeapon    String?
  favoriteCharacter String?
  preferredRole     String?
  preferredPosition String?
  gameAchievements  String[] @default([])
  hoursPlayed       Float    @default(0)
  lastActive        DateTime?
  leaderboardPos    Int?
  verificationStatus String  @default("Manual")
  dataSource        String   @default("Manual")
  profileId         String
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([profileId])
  @@index([gameName])
}

model GamerSkill {
  id        String   @id @default(uuid())
  name      String
  score     Int      @default(0)
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model Endorsement {
  id          String   @id @default(uuid())
  skill       String
  message     String?
  createdAt   DateTime @default(now())
  endorserId  String
  endorser    User     @relation(fields: [endorserId], references: [id])
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
  @@index([endorserId])
}

model Achievement {
  id          String   @id @default(uuid())
  key         String?
  title       String
  description String?
  icon        String?
  rarity      String?
  progress    Int      @default(0)
  progressMax Int?
  unlockedAt  DateTime @default(now())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([profileId, key])
  @@index([profileId])
}

model Certification {
  id          String   @id @default(uuid())
  title       String
  issuer      String?
  issueDate   DateTime?
  expiryDate  DateTime?
  credentialUrl String?
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model TournamentHistory {
  id           String   @id @default(uuid())
  tournamentName String
  placement    String?
  prize        String?
  date         DateTime @default(now())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([profileId])
}

model Post {
  id          String   @id @default(uuid())
  type        PostType @default(POST)
  content     String
  media       String[]
  tags        String[]
  isPinned    Boolean  @default(false)
  isPublished Boolean  @default(true)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    Comment[]
  likes       Like[]
  hashtags    PostHashtag[]
  poll        Poll?
  views       PostView[]
  @@index([userId])
  @@index([createdAt])
  @@index([isPublished, createdAt])
  @@index([userId, isPublished, createdAt(sort: Desc)])
}

model ProfileView {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  viewerId  String?
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewerIp  String?
  createdAt DateTime @default(now())
  @@index([profileId, createdAt])
  @@index([viewerId])
}

model PostView {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewerId  String?
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewerIp  String?
  createdAt DateTime @default(now())
  @@index([postId, createdAt])
  @@index([viewerId])
}

model Poll {
  id        String   @id @default(uuid())
  question  String
  options   PollOption[]
  expiresAt DateTime?
  postId    String   @unique
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PollOption {
  id       String @id @default(uuid())
  text     String
  votes    Int    @default(0)
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  voters   PollVoter[]
}

model PollVoter {
  id           String     @id @default(uuid())
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([pollOptionId, userId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  media     String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  likes     Like[]
  @@index([postId])
  @@index([userId])
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Hashtag {
  id    String @id @default(uuid())
  name  String @unique
  count Int    @default(0)
  posts PostHashtag[]
}

model PostHashtag {
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  @@id([postId, hashtagId])
}

model Chat {
  id        String   @id @default(uuid())
  name      String?
  isGroup   Boolean  @default(false)
  isTeam    Boolean  @default(false)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants ChatParticipant[]
  messages     Message[]
  typingIndicators TypingIndicator[]
}

model ChatParticipant {
  id        String   @id @default(uuid())
  joinedAt  DateTime @default(now())
  lastReadAt DateTime?
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([chatId, userId])
  @@index([userId])
}

model Message {
  id         String   @id @default(uuid())
  content    String?
  media      String[]
  voiceNote  String?
  gif        String?
  fileUrl    String?
  fileName   String?
  fileSize   Int?
  isEdited   Boolean  @default(false)
  isDeleted  Boolean  @default(false)
  isPinned   Boolean  @default(false)
  parentId   String?
  parent     Message? @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Message[] @relation("MessageReplies")
  reactions  ChatMessageReaction[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readBy     MessageRead[]
  @@index([chatId])
  @@index([senderId])
  @@index([parentId])
  @@index([createdAt])
  @@index([chatId, createdAt])
}

model ChatMessageReaction {
  id        String   @id @default(uuid())
  emoji     String
  createdAt DateTime @default(now())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId, emoji])
  @@index([userId])
  @@index([messageId])
}

model MessageRead {
  id        String   @id @default(uuid())
  readAt    DateTime @default(now())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId])
}

model TypingIndicator {
  id     String @id @default(uuid())
  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([chatId, userId])
}

model Team {
  id          String     @id @default(uuid())
  name        String     @unique
  tag         String?
  description String?
  avatar      String?
  banner      String?
  status      TeamStatus @default(ACTIVE)
  rank        String?
  rankScore   Int        @default(0)
  region      String?
  wins        Int        @default(0)
  losses      Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  members     TeamMember[]
  invites     TeamInvite[]
  applications TeamApplication[]
  practiceSchedules PracticeSchedule[]
  scrims      Scrim[]
  tournaments TournamentTeam[]
  tournamentInvitations TournamentInvitation[]
  @@index([name])
  @@index([rank])
  @@index([region])
}

model TeamMember {
  id        String   @id @default(uuid())
  role      TeamRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
}

model TeamInvite {
  id        String   @id @default(uuid())
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId])
}

model TeamApplication {
  id        String   @id @default(uuid())
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([teamId, userId])
  @@index([userId])
}

model PracticeSchedule {
  id         String   @id @default(uuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model Scrim {
  id          String   @id @default(uuid())
  title       String
  description String?
  scheduledAt DateTime
  duration    Int
  status      String   @default("SCHEDULED")
  opponentTeam String?
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Tournament {
  id              String           @id @default(uuid())
  title           String
  description     String?
  game            String
  type            TournamentType   @default(SINGLE_ELIMINATION)
  status          TournamentStatus @default(DRAFT)
  maxTeams        Int
  minTeamSize     Int              @default(1)
  maxTeamSize     Int              @default(5)
  prizePool       Float            @default(0)
  entryFee        Float            @default(0)
  rules           String?
  bracketUrl      String?
  checkInWindowMinutes Int         @default(15)
  reminderMinutes Int              @default(5)
  payoutStage     String           @default("PENDING") // PENDING | DISTRIBUTING | COMPLETED
  payoutDetails   Json?
  mapPool         String[]         @default([])
  customFields    Json?
  startDate       DateTime
  endDate         DateTime?
  registrationEnd DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organizerId     String
  organizer       Organization     @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  teams           TournamentTeam[]
  matches         Match[]
  participants    TournamentParticipant[]
  disputes        MatchDispute[]
  activities      TournamentActivityFeed[]
  tickets         TournamentSupportTicket[]
  invitations     TournamentInvitation[]
  announcements   TournamentAnnouncement[]
  organizerRatings TournamentOrganizerRating[]
  results         TournamentResult[]
  @@index([status])
  @@index([game])
  @@index([startDate])
}

model TournamentTeam {
  id                  String             @id @default(uuid())
  seed                Int?
  placement           Int?
  readinessScore      Int                @default(0)
  checkedIn           Boolean            @default(false)
  registrationStatus  String             @default("ACCEPTED") // PENDING_REVIEW | ACTION_REQUIRED | ACCEPTED | REJECTED | WAITLISTED | WITHDRAWN
  actionRequiredNotes String?
  status              RegistrationStatus @default(PENDING)
  rejectionReason     String?
  customResponses     Json?
  checkInStatus       CheckInStatus      @default(NOT_CHECKED_IN)
  checkedInAt         DateTime?
  registeredAt        DateTime           @default(now())
  tournamentId        String
  tournament          Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId              String
  team                Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members             TournamentTeamMember[]
  matchesAsTeam1      Match[]            @relation("Team1")
  matchesAsTeam2      Match[]            @relation("Team2")
  activities          TournamentActivityFeed[]
  result              TournamentResult?
  @@unique([tournamentId, teamId])
  @@index([status])
  @@index([checkInStatus])
}

model TournamentInvitation {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviterId    String
  inviter      User       @relation("InvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId    String
  invitee      User       @relation("InvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  status       String     @default("PENDING") // PENDING | ACCEPTED | DECLINED
  createdAt    DateTime   @default(now())

  @@index([tournamentId])
  @@index([inviteeId])
}

model TournamentTeamMember {
  id                String             @id @default(uuid())
  tournamentTeamId  String
  tournamentTeam    TournamentTeam     @relation(fields: [tournamentTeamId], references: [id], onDelete: Cascade)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  isSubstitute      Boolean            @default(false)
  @@unique([tournamentTeamId, userId])
}

model TournamentParticipant {
  id            String     @id @default(uuid())
  role          String?
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, userId])
}

model Match {
  id                String          @id @default(uuid())
  round             Int
  matchIndex        Int
  status            MatchStatus     @default(SCHEDULED)
  scheduledAt       DateTime?
  completedAt       DateTime?
  winnerId          String?
  scoreTeam1        Int?
  scoreTeam2        Int?
  team1CheckedIn    Boolean         @default(false)
  team2CheckedIn    Boolean         @default(false)
  mapVetoState      Json?
  roomId            String?
  roomPassword      String?
  instructions      String?
  evidenceUrl       String?
  submittedByUserId String?
  bracket           Json?
  tournamentId      String
  tournament        Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team1Id           String?
  team1             TournamentTeam? @relation("Team1", fields: [team1Id], references: [id])
  team2Id           String?
  team2             TournamentTeam? @relation("Team2", fields: [team2Id], references: [id])
  disputes          MatchDispute[]
  activities        TournamentActivityFeed[]
  @@index([tournamentId])
}

model TournamentActivityFeed {
  id           String          @id @default(uuid())
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String?
  team         TournamentTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  matchId      String?
  match        Match?          @relation(fields: [matchId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         String          // REGISTRATION | CHECK_IN | MATCH_START | SCORE_SUBMITTED | DISPUTE | ANNOUNCEMENT
  title        String
  message      String
  metadata     Json?
  createdAt    DateTime        @default(now())

  @@index([tournamentId])
  @@index([createdAt])
}

model TournamentSupportTicket {
  id           String          @id @default(uuid())
  ticketNumber String          @unique
  tournamentId String
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matchId      String?
  reporterId   String
  reporter     User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  category     String          // SCORE_DISPUTE | ROSTER_ISSUE | CHEATING | TECHNICAL | GENERAL
  subject      String
  description  String
  status       String          @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority     String          @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  resolution   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     TicketMessage[]

  @@index([tournamentId])
  @@index([reporterId])
  @@index([status])
}

model TicketMessage {
  id            String                  @id @default(uuid())
  ticketId      String
  ticket        TournamentSupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User                    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderRole    String                  @default("PLAYER") // PLAYER | ADMIN | MATCH_ADMIN
  message       String
  attachmentUrl String?
  createdAt     DateTime                @default(now())

  @@index([ticketId])
}

model TournamentAnnouncement {
  id           String     @id @default(uuid())
  title        String
  content      String
  isPinned     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  @@index([tournamentId])
}

model TournamentOrganizerRating {
  id           String     @id @default(uuid())
  rating       Int
  feedback     String?
  createdAt    DateTime   @default(now())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

// ─── Match disputes (result verification / appeals) ────────────────────────

model MatchDispute {
  id           String   @id @default(uuid())
  reason       String
  description  String?
  status       String   @default("OPEN") // OPEN | RESOLVED | DISMISSED
  resolution   String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User     @relation(fields: [reporterId], references: [id])
  @@index([matchId])
  @@index([tournamentId])
  @@index([status])
}

model TournamentResult {
  id            String         @id @default(uuid())
  tournamentId  String
  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId        String         @unique
